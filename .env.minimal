# ─────────────────────────────────────────────────────────────────────────────
# 最小配置 —— 首次运行唯一需要的变量。
#
#   cp .env.minimal .env      然后设置下面的 OPENAI_API_KEY
#
# 其余一切都有可用默认值。完整配置面 —— 鉴权模式、OAuth、MCP、遥测、护栏、
# 事实核验、成本预算 —— 在 .env.example 中，它属于参考资料而非起点。
#
# 这个文件如何抵达运行中的服务：docs/configuration.md
# ─────────────────────────────────────────────────────────────────────────────

LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key-here

# ── 没有 API key？────────────────────────────────────────────────────────────
# 任何 OpenAI 兼容端点都走同一条代码路径。把上面的 key 注释掉，取消注释下面这几行，
# 改用本地模型。该模型必须支持工具调用 —— 已验证可用的模型见 docs/quick-start.md。
#
# LLM_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# LLM_MODEL=qwen2.5:14b
