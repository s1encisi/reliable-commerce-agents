# ============================================================
# 可靠电商多智能体平台 —— 环境配置
# ============================================================
# 复制为 .env 并配置你的 LLM 提供方：
#   cp .env.example .env
#
# 支持三种 LLM 提供方。取消注释其中一节即可。
# 所有智能体、工具与向量嵌入生成都使用同一个提供方。
# ============================================================


# ── LLM 提供方 ───────────────────────────────────────────────
# 设为 "openai"、"azure" 或 "replay" —— 控制全部 LLM 与向量嵌入调用
LLM_PROVIDER=openai


# ┌────────────────────────────────────────────────────────────┐
# │  方案 A：OpenAI（或任何 OpenAI 兼容端点）                    │
# │  设置 LLM_PROVIDER=openai 并填写下面的内容                   │
# └────────────────────────────────────────────────────────────┘

OPENAI_API_KEY=sk-your-openai-api-key-here
# 模型名迭代很快。请从你所用提供方的在线列表
# —— https://developers.openai.com/api/docs/models —— 挑一个当前的对话模型填进来，
# 而不要把下面的值当作推荐。它只是一个已知可用的下限。
LLM_MODEL=gpt-4.1
EMBEDDING_MODEL=text-embedding-3-small

# 可选：把 OpenAIChatClient 指向 api.openai.com 之外的 OpenAI 兼容端点 ——
# Ollama、OpenRouter、vLLM、LM Studio 等。仅在 LLM_PROVIDER=openai 时生效。
# 留空则直接使用 OpenAI。
#
# Ollama 是免费路径 —— 完全本地、零成本、零网络、无需账号。
# 启动时请调大上下文窗口（默认的 4K 会静默截断智能体循环）：
#   OLLAMA_CONTEXT_LENGTH=64000 ollama serve
#   LLM_BASE_URL=http://localhost:11434/v1
#   OPENAI_API_KEY=ollama  （任意非空字符串 —— Ollama 不会校验它）
#   LLM_MODEL=qwen2.5:14b   （选模型前请先看下面的「坑」）
#
# LM Studio —— 思路相同，先在 LM Studio 的本地服务器里加载一个模型：
#   LLM_BASE_URL=http://localhost:1234/v1
#   OPENAI_API_KEY=lm-studio  （任意非空字符串）
#   LLM_MODEL=<LM Studio 服务器页签中显示的模型标识符>
#
# 坑：本仓库的每个专业智能体都重度依赖工具调用（`@tool` 装饰器就是它们读取数据库的方式）。
# 许多小型/量化本地模型宣称支持 OpenAI 兼容的 chat completions，但函数调用支持并不可靠、
# 甚至完全缺失 —— 智能体不会报错，它只会静默地停止调用工具，转而凭（编造的）记忆作答。
# 2026-08-21 在一个双工具多轮循环上实测，qwen2.5:14b、gemma4:12b 与 qwen3.5:9b 都能通过。
# 推荐默认用 qwen2.5:14b：它不输出推理轨迹，因此比通用小型对话模型快约 6 倍，
# 也不会把整个输出预算花在思考上、最后返回空内容。如果回复不再提及真实的商品/订单数据，
# 那是第一个该排查的地方 —— 而不是本仓库代码的缺陷。
#
# OpenRouter / vLLM：使用同样的 LLM_BASE_URL 机制，无需改代码 ——
# 按上面的示例方式指向你的 OpenRouter base URL 或自托管的 vLLM 服务即可。
# LLM_BASE_URL=


# ┌────────────────────────────────────────────────────────────┐
# │  方案 B：Azure OpenAI                                      │
# │  设置 LLM_PROVIDER=azure 并填写下面的内容                    │
# └────────────────────────────────────────────────────────────┘

# LLM_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_KEY 是本仓库原生的名称。AZURE_OPENAI_API_KEY（MAF 文档风格）
# 作为别名同样被接受 —— 设置其中任意一个即可。
AZURE_OPENAI_KEY=
# AZURE_OPENAI_DEPLOYMENT 是本仓库原生的名称。AZURE_OPENAI_DEPLOYMENT_NAME
# 作为别名同样被接受。
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2025-03-01-preview

# Azure 向量嵌入部署（未设置时使用 EMBEDDING_MODEL 的名称）
AZURE_EMBEDDING_DEPLOYMENT=


# ┌────────────────────────────────────────────────────────────┐
# │  方案 C：Replay —— 无需凭据、无需网络                        │
# │  设置 LLM_PROVIDER=replay。回放已录制的 fixture。            │
# │  见 shared/replay_client.py / tutorials/_shared/replay_client.py │
# └────────────────────────────────────────────────────────────┘

# LLM_PROVIDER=replay
# 已录制请求/响应 fixture 的目录，按请求哈希索引。
# REPLAY_FIXTURES_DIR=tests/fixtures/replay
# 设为 true 时，遇到缺失的 fixture 就改为录制一次真实调用（经由 REPLAY_RECORD_PROVIDER），
# 而不是抛错。需要 REPLAY_RECORD_PROVIDER 所指提供方的真实凭据。
# RECORD=false
# REPLAY_RECORD_PROVIDER=openai


# ── 数据库 ───────────────────────────────────────────────────
# 这里用 @localhost。docker-compose.yml 为容器内服务硬编码了自己的 DATABASE_URL
# （带 @db），所以这个值只会被宿主机侧的脚本使用：评测、种子脚本与本地 REPL 会话。
POSTGRES_DB=ecommerce_agents
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce_secret
DATABASE_URL=postgresql://ecommerce:ecommerce_secret@localhost:5432/ecommerce_agents


# ── Redis ────────────────────────────────────────────────────
# 与 DATABASE_URL 同理 —— 宿主机侧脚本用 localhost，容器用 redis。
REDIS_URL=redis://localhost:6379


# ── 鉴权 ─────────────────────────────────────────────────────
# 生成密钥：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-generate-a-random-256-bit-key
AGENT_SHARED_SECRET=agent-internal-shared-secret

# ── OAuth2（可选；自托管，无外部 IdP）──────────────────────────
# AUTH_MODE=local（默认）会保持上面的 JWT_SECRET/AGENT_SHARED_SECRET 行为不变。
# 设置 AUTH_MODE=oauth 可把用户登录与 A2A/MCP 鉴权改走自托管的 auth-server ——
# 用 `docker compose --profile agents up auth-server` 启动它。这里的一切都不需要
# 联网，也不需要任何身份提供方的账号。
AUTH_MODE=local
AUTH_SERVER_ISSUER=http://localhost:8090
AUTH_SERVER_JWKS_URL=http://localhost:8090/.well-known/jwks.json
AUTH_SERVER_TOKEN_URL=http://localhost:8090/oauth/token
AUTH_ACCESS_TOKEN_TTL=3600
AUTH_REFRESH_TOKEN_TTL=604800
AUTH_JWKS_CACHE_TTL=900
AUTH_RSA_KEY_SIZE=2048
# 用于在静态存储中加密 auth-server 的签名私钥。在开发环境之外且
# AUTH_MODE=oauth 时必填；用上面的命令生成。
AUTH_SIGNING_KEY_ENCRYPTION_KEY=
# 客户端凭据授予中每个服务的客户端身份。每个服务的 OAUTH_CLIENT_ID 默认就是它自己的名字；
# 开发环境可让 OAUTH_CLIENT_SECRET 留空、由 OAUTH_SEED_KEY 派生，
# 生产环境则为每个服务显式设置密钥。
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_SEED_KEY=dev-oauth-seed-change-me
AUTH_ORCH_AUDIENCE=ecommerce-orchestrator
AUTH_AGENT_AUDIENCE=ecommerce-agents
# 当智能体间调用转发的 X-User-Email/X-User-Role 头看起来被伪造时，拒绝（而不只是记录）该调用。
# 在 local 与 oauth 两种模式下都会检查。
GUARDRAILS_STRICT_IDENTITY=false
# RFC 7591 动态客户端注册（POST /oauth/register），默认关闭 —— 客户端注册表除此之外是固定/
# 预置的。即使为 true，注册仍需要一个作用域为 client:register 的 bearer token
# （见 scripts/seed.py 中预置的 "auth-admin" 客户端）。
AUTH_ALLOW_DYNAMIC_REGISTRATION=false
AUTH_SERVER_AUDIENCE=ecommerce-auth-server

# MCP 资源服务器鉴权（独立于下面的 MCP_ENABLED）。
MCP_AUTH_ENABLED=false
MCP_PRODUCT_AUDIENCE=mcp-product
MCP_INVENTORY_AUDIENCE=mcp-inventory
MCP_PRODUCT_REQUIRED_SCOPE=mcp:product
MCP_INVENTORY_REQUIRED_SCOPE=mcp:inventory
MCP_PRODUCT_RESOURCE_URL=http://mcp-product:9000/mcp
MCP_INVENTORY_RESOURCE_URL=http://mcp-inventory:9001/mcp


# ── 遥测（OpenTelemetry → Jaeger）────────────────────────────
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=ecommerce.orchestrator

# ── Langfuse（可选的并行 OTel 接收端）─────────────────────────
# 在 https://cloud.langfuse.com → Project Settings 获取密钥
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com


# ── MCP 集成（可选）──────────────────────────────────────────
# 先启动 MCP 服务器：docker compose --profile mcp up
# 然后设置 MCP_ENABLED=true 并重启专业智能体。
MCP_ENABLED=false
MCP_PRODUCT_SERVER_URL=http://mcp-product:9000/mcp
MCP_INVENTORY_SERVER_URL=http://mcp-inventory:9001/mcp


# ── 通用 ─────────────────────────────────────────────────────
ENVIRONMENT=development


# ── 智能体注册表 ─────────────────────────────────────────────
# 用于智能体间 A2A 通信的 Docker 内网 URL
AGENT_REGISTRY={"product-discovery":"http://product-discovery:8081","order-management":"http://order-management:8082","pricing-promotions":"http://pricing-promotions:8083","review-sentiment":"http://review-sentiment:8084","inventory-fulfillment":"http://inventory-fulfillment:8085"}


# ── 前端 ─────────────────────────────────────────────────────
# 前端服务端 /api/* 代理的转发目标。它是服务端变量，不是 NEXT_PUBLIC_*：
# 浏览器只会调用前端自己的源，因此这个值在运行时读取，永远不会被编译进 bundle。
# 在 compose 内它是服务名；在运行 `pnpm dev` 的宿主机上它是 localhost。
ORCHESTRATOR_URL=http://localhost:8080


# ── MAF v1 特性开关（可选 —— 安全默认值保持当前行为）──────────
# 这些开关支撑把线上应用重构为 MAF 原生习惯用法的 Phase 7 工作。
# 只有想退出新默认值时才取消注释某一行。

# MAF_SESSION_BACKEND=postgres     # postgres | file | memory
# MAF_SESSION_DIR=./.sessions
# MAF_CHECKPOINT_BACKEND=postgres  # postgres | file | memory
# MAF_CHECKPOINT_DIR=./.checkpoints
# RETURN_HITL_THRESHOLD=500        # 退货/换货超过该阈值时暂停等待人工审批
# HANDOFF_AUTONOMOUS_MODE=true     # true → 专业智能体自动响应；false → 暴露交接事件
# HANDOFF_MAX_TURNS=3              # 初筛智能体在自主模式下的轮次上限。
#                                  # MAF 默认是 50；一个无法交接的初筛智能体
#                                  # 就是这样产出 23k 字符独白的。
# WORKFLOW_VISUALIZATION_ON_BUILD=false  # true → CI 重新生成 docs/workflows/*.mmd 并在漂移时失败
